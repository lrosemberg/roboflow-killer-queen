{
  "name": "roboflow-rumble",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A Roboflow raccoon team arcade with themed Classic and XXL arenas, LAN and online play.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "loadtest": "node scripts/load-test.mjs",
    "internet": "cloudflared tunnel --url http://localhost:8787 --no-autoupdate --protocol http2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "railway": "^3.16.0"
  }
}
